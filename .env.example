# ==============================================================================
# NESTORA — Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development. Never commit secrets!

# Supabase Public Configuration (Exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role (Server-side ONLY - Never expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Data Mode Switch ('demo' | 'live')
# 'demo': Uses local demo data & simulated storage (default fallback if Supabase unconfigured)
# 'live': Queries Supabase directly using PostgreSQL + RLS + Supabase Auth
NEXT_PUBLIC_DATA_MODE=demo
