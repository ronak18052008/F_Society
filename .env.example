# ==============================================================================
# NESTORA — Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development. Never commit secrets!

# Frontend Public Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side Supabase Service Role Key (NEVER expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Demo fallback toggle (false for real database queries)
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Resend Email API
RESEND_API_KEY=re_your_resend_api_key

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
